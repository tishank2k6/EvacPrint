# Copy to .env.local (never commit it). Only the EvacPrint server reads these keys;
# they are never sent to the browser. Set ONE of them.

# Free option: Google Gemini (free tier) — create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: another Gemini model (default gemini-3.5-flash-lite; if it is busy the
# server falls back to gemini-3.1-flash-lite, then gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Paid option: Anthropic Claude (used instead of Gemini when set)
ANTHROPIC_API_KEY=
# EVACPRINT_AI_MODEL=claude-opus-5-5
# EVACPRINT_AI_EFFORT=low
